# TripSplit development container environment variables.
#
# These are the default values; secrets never live here. The MVP is
# offline-first and has no backend configuration.

# Android SDK location inside the container.
ANDROID_HOME=/opt/android-sdk-linux
ANDROID_SDK_ROOT=/opt/android-sdk-linux

# Keep Flutter/Dart tooling deterministic.
PUB_CACHE=/root/.pub-cache
GRADLE_USER_HOME=/root/.gradle

# Locale for stable tooling output.
LANG=C.UTF-8
LC_ALL=C.UTF-8