# TripSplit funding server — environment template.
#
# Copy to `.env` (same directory) and fill in real values:
#
#   cp .env.example .env
#
# Secrets are read ONLY by the server process. They are never compiled into
# the Flutter app, never committed, and never returned by any HTTP endpoint.
# ONLY the public RAZORPAY_KEY_ID may reach the mobile client, and even then
# it is served at order creation by this backend — not embedded in the APK.
#
# The `.env` file is git-ignored. Platform environment variables (Docker/K8s
# secrets, CI secrets, production hosts) always override `.env` values.

# ---------------------------------------------------------------------------
# Environment separation (Development / Staging / Production)
# ---------------------------------------------------------------------------
# FUNDING_ENV: 'development', 'staging', or 'production'. 'test' (default)
# adds permissive CORS for local development.
FUNDING_ENV=development

# GATEWAY_MODE: 'simulated' (sandbox, no credentials) or 'razorpay' (real).
# Development and Staging must use 'razorpay' with Razorpay TEST keys.
# Production uses 'razorpay' with Razorpay LIVE keys.
GATEWAY_MODE=simulated

# ---------------------------------------------------------------------------
# Razorpay credentials (required when GATEWAY_MODE=razorpay)
# ---------------------------------------------------------------------------
# Public Key Id. Not a secret, but keep it here anyway so the server is the
# single source of truth for which key the app talks to.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Server-only Key Secret. NEVER expose this to Flutter/APK/GitHub.
RAZORPAY_KEY_SECRET=

# Webhook secret configured on the Razorpay Dashboard
# (Settings > Webhooks). Used to HMAC-verify inbound webhook payloads.
RAZORPAY_WEBHOOK_SECRET=

# Optional: override the Razorpay API base URL (proxies/mocks/test harness).
# RAZORPAY_API_BASE=https://api.razorpay.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Embedded SQLite database for the isolated funding ledger. DATABASE_URL is an
# accepted alias; only file paths / `file:` URLs are supported.
# FUNDING_DB_PATH=funding.sqlite3
# DATABASE_URL=file:funding.sqlite3

# ---------------------------------------------------------------------------
# Server tuning
# ---------------------------------------------------------------------------
# PORT=8080
# MAX_BODY_BYTES=1048576

# Terms version currently accepted. Must match the Flutter app's
# FundingConfig.currentTermsVersion. NOTE: today the effective terms version
# is set in lib/config/legal_copy.dart (currently 2026-09-21); this variable is
# not yet wired to that code path.
# CURRENT_TERMS_VERSION=2026-09-21

# Public base URL used to build links. NOTE: currently has no effect (no link
# is generated by the server today).
# FUNDING_PUBLIC_BASE_URL=https://funding.example.com

# Admin key guarding /reconciliation. Set in production.
# FUNDING_ADMIN_KEY=